            CircleBar.Position = UDim2.new(1, 0, 0.5, 0)
            CircleBar.Size = UDim2.new(0, 10, 0, 10)

            CircleCorner.CornerRadius = UDim.new(0, 100)
            CircleCorner.Parent = CircleBar

            local dragging = false
            local UserInputService = game:GetService("UserInputService")

            local function updateSlider(input)
                local pos = math.clamp(input.Position.X - Bar1.AbsolutePosition.X, 0, Bar1.AbsoluteSize.X)
                local value = math.floor((pos / Bar1.AbsoluteSize.X * (max - min) + min) * 10 + 0.5) / 10
                Bar.Size = UDim2.new(pos / Bar1.AbsoluteSize.X, 0, 1, 0)
                CircleBar.Position = UDim2.new(1, 0, 0.5, 0)
                SValue.Text = tostring(value)
                pcall(function() callback(value) end)
            end

            SliderButton.MouseButton1Down:Connect(function()
                dragging = true
            end)

            SliderButton.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateSlider(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging then
                    if input.UserInputType == Enum.UserInputType.MouseMovement then
                        local mousePos = game.Players.LocalPlayer:GetMouse()
                        updateSlider(Vector2.new(mousePos.X, mousePos.Y))
                    elseif input.UserInputType == Enum.UserInputType.Touch then
                        updateSlider(input.Position)
                    end
                end
            end)

            return {}
        end

